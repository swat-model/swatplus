/bin
# SWAT+ writes model output into whichever directory it runs in, including the
# reference datasets. refdata/ holds INPUTS ONLY -- all 238 tracked files there
# are SWAT+ input extensions (bsn, sol, cli, con, ops, ...) and not one is a
# .txt/.csv/.out. These three patterns replace 44 hand-listed
# /refdata/Osu_1hru/*.txt entries and cover every subfolder automatically.
refdata/**/*.txt
refdata/**/*.csv
refdata/**/*.out

# Fixture-cleaning helper. The canonical copy lives in workdata/ (gitignored);
# it is not part of the reference data and must not be committed if it reappears.
refdata/clean_files.sh

[Tt]mp/
/workdata
/analysis/
